# Copy to .env.production.local, replace every placeholder, and chmod 0600.
CRM_STORE=mysql
CRM_SEED_DEVELOPMENT_DATA=false
DATABASE_URL=mysql://shensi_app:replace_with_url_encoded_mysql_app_password@mysql:3306/shensi
# Aiven/remote MySQL: paste the provider CA certificate as a multiline secret
# and use verified TLS. Keep disabled for the local Compose MySQL service.
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA=
SHENSI_MYSQL_APP_PASSWORD=replace_with_exact_mysql_app_password_file_content
PORT=4188
BACKEND_HOST=0.0.0.0
TRUSTED_PROXY_CIDRS=172.30.0.4/32
JWT_SECRET=replace_with_at_least_32_random_characters
PROVIDER_CREDENTIAL_KEY=replace_with_a_separate_32_plus_character_random_key
AGENT_JOB_ENCRYPTION_KEY=replace_with_a_distinct_32_plus_character_random_key
ACQUISITION_MASTER_SECRET=replace_with_a_distinct_32_plus_character_random_key
MEDIACRAWLER_BASE_URL=http://media-crawler:8899
MEDIACRAWLER_SERVICE_SECRET_FILE=deploy/secrets/mediacrawler_service_secret
MEDIACRAWLER_ENCRYPTED_VOLUME=/replace/with/encrypted/mediacrawler-state
MEDIACRAWLER_PROFILE_ROOT=/replace/with/encrypted/mediacrawler-state/profiles
DOUYIN_OUTREACH_ACTIONS_ENABLED=false
# Legacy Sidecar switch above does not enable backend roles.
DOUYIN_OUTREACH_APPROVALS_ENABLED=false
DOUYIN_OUTREACH_SERVER_EXECUTION_ENABLED=false
DOUYIN_OUTREACH_DESKTOP_EXECUTION_ENABLED=false
# exact is reserved for the joint App/Backend/Gateway milestone and requires
# its approved App's 64-character lowercase SHA-256 digest. Locked means empty.
SHENSI_DESKTOP_CLIENT_ADMISSION_MODE=migration_locked
SHENSI_DESKTOP_ADMITTED_BUILD_MANIFEST_SHA256=
# Optional only in exact mode: up to seven additional, unique lowercase digests
# for a bounded arm64/x64 or rolling-release overlap. Keep empty while locked.
SHENSI_DESKTOP_ADDITIONAL_ADMITTED_BUILD_MANIFEST_SHA256S=
# disabled (default) builds no OCR extra; rapidocr installs and enables only
# the pinned local fallback inside the private sidecar image.
DOUYIN_ACTION_VISUAL_LOCATOR=disabled
# Collection-only default. Set false and provide an acceptance-tested visible
# browser/display before changing DOUYIN_OUTREACH_ACTIONS_ENABLED to true.
MEDIACRAWLER_BROWSER_HEADLESS=true
MEDIACRAWLER_BROWSER_CHANNEL=
TRADE_OBSERVATION_CURSOR_SECRET=replace_with_another_32_plus_character_random_key
MARKET_OPPORTUNITY_CURSOR_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_RUN_IDEMPOTENCY_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_RUN_CURSOR_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_EXECUTION_CLAIM_SECRET=replace_with_a_distinct_32_plus_character_random_key
ORGANIZATION_IDENTITY_MASTER_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_SOURCE_RAW_ENVELOPE_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_COVERAGE_MASTER_SECRET=replace_with_a_distinct_32_plus_character_random_key
PROSPECT_WORKER_ENABLED=true
PROSPECT_WORKER_POLL_MS=1000
REDIS_URL=
PROSPECT_QUEUE_REQUIRED=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_12_plus_character_password
INITIAL_ADMIN_NAME=Super Admin
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=https://replace_with_your_shensi_hostname
ENABLE_API_DOCS=false
SHENSI_HTTP_PORT=8080
