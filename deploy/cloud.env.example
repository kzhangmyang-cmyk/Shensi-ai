# Compose interpolation only. Use private absolute paths; never put keys here.
# Run scripts/cloud-deployment-check.mjs before starting this deployment.
SHENSI_CLOUD_HOSTNAME=api.example.invalid
SHENSI_CLOUD_BIND_ADDRESS=127.0.0.1
SHENSI_CLOUD_BACKEND_IMAGE=registry.example.invalid/shensi/backend@sha256:REPLACE_WITH_TESTED_DIGEST
SHENSI_CLOUD_FRONTEND_IMAGE=registry.example.invalid/shensi/frontend@sha256:REPLACE_WITH_TESTED_DIGEST
SHENSI_CLOUD_GATEWAY_IMAGE=nginxinc/nginx-unprivileged@sha256:REPLACE_WITH_APPROVED_DIGEST
SHENSI_CLOUD_BACKEND_ENV_FILE=/private/shensi/backend.env
SHENSI_CLOUD_TLS_CERT_FILE=/private/shensi/tls/fullchain.pem
SHENSI_CLOUD_TLS_KEY_FILE=/private/shensi/tls/privkey.pem
SHENSI_CLOUD_ADMIN_ALLOW_FILE=/private/shensi/admin-allow.conf
SHENSI_CLOUD_INTERNAL_SUBNET=172.31.80.0/24
SHENSI_CLOUD_GATEWAY_IP=172.31.80.4
