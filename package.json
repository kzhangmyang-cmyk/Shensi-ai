{
  "name": "shensi-sales",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./backend dev:mysql\" \"pnpm --filter ./frontend dev\"",
    "dev:mysql": "concurrently \"pnpm --filter ./backend dev:mysql\" \"pnpm --filter ./frontend dev\"",
    "build": "pnpm --filter ./contracts check:types && pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "generate:frontend-contract-types": "pnpm --filter ./contracts generate:types",
    "check:generated-acquisition-types": "pnpm --filter ./contracts check:types",
    "build:growth-contract-release": "pnpm --filter ./contracts build:growth-release",
    "check:growth-contract-release": "pnpm --filter ./contracts check:growth-release",
    "check:growth-contracts": "pnpm check:growth-contract-release && pnpm --filter ./backend test:growth-openapi",
    "check:acquisition-contracts": "pnpm test:contracts && pnpm --filter ./backend test:contract-drift && pnpm --filter ./backend test:security && pnpm --filter ./backend test:acquisition-openapi && pnpm check:generated-acquisition-types && pnpm --filter ./frontend build && pnpm --filter ./frontend test && pnpm test:baota-package",
    "test:contracts": "pnpm --filter ./contracts test",
    "test:baota-package": "node --test deploy/baota/build-package.test.mjs",
    "test": "pnpm test:contracts && pnpm --filter ./backend test && pnpm --filter ./frontend test && pnpm test:baota-package",
    "test:layout": "node --test tools/shensi-monorepo-layout.test.mjs",
    "test:financial-council": "pnpm --filter ./backend test:financial-council",
    "test:e2e": "pnpm --filter ./frontend test:e2e",
    "test:e2e:financial-council:real": "pnpm --filter ./frontend test:e2e:financial-council:real",
    "test:growth-release-gate": "node --test tools/growth-dual-repo-release-gate.test.mjs",
    "release:growth": "node tools/growth-dual-repo-release-gate.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
