{
  "name": "shensi-sales",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "website:dev": "pnpm --dir frontend exec vite ../website --config ../website/vite.config.ts",
    "website:build": "pnpm --dir frontend exec tsc -p ../website/tsconfig.json && pnpm --dir frontend exec vite build ../website --config ../website/vite.config.ts && pnpm --dir frontend exec tsx ../website/scripts/prerender.ts",
    "website:preview": "pnpm --dir frontend exec vite preview ../website --config ../website/vite.config.ts",
    "website:serve": "node website/server/server.mjs",
    "website:test": "node --test website/server/contact.test.mjs",
    "api:prepare": "node scripts/api-only-runtime.mjs prepare",
    "api:runtime:doctor": "node scripts/container-runtime.mjs doctor",
    "api:db:start": "node scripts/api-only-runtime.mjs db-start",
    "api:start": "node scripts/api-only-runtime.mjs start",
    "api:stop": "node scripts/api-only-runtime.mjs stop",
    "api:status": "node scripts/api-only-runtime.mjs status",
    "api:verify": "node scripts/api-only-runtime.mjs verify",
    "api:verify:empty": "node scripts/api-only-runtime.mjs verify-empty",
    "api:verify:desktop-action-storage:installation": "node scripts/verify-desktop-action-storage.mjs installation",
    "api:verify:desktop-action-storage:binding": "node scripts/verify-desktop-action-storage.mjs binding",
    "api:verify:desktop-action-storage:actions": "node scripts/verify-desktop-action-storage.mjs actions",
    "api:verify:desktop-action-storage:all": "node scripts/verify-desktop-action-storage.mjs all",
    "api:verify:desktop-action-bridge:mysql": "node scripts/verify-desktop-action-storage.mjs bridge-mysql",
    "api:verify:multi-mac-crm:mysql": "node scripts/verify-desktop-action-storage.mjs multi-mac-crm",
    "api:migration:preflight": "node scripts/api-only-runtime.mjs migration-preflight",
    "api:migration:run": "node scripts/api-only-runtime.mjs migration-run",
    "api:cutover": "node scripts/api-only-runtime.mjs cutover",
    "api:rollback": "node scripts/api-only-runtime.mjs rollback",
    "api:accept:prepare": "node scripts/api-only-runtime.mjs accept-prepare",
    "api:accept": "node scripts/api-only-runtime.mjs accept",
    "api:accept:resume": "node scripts/api-only-runtime.mjs accept-resume",
    "api:active-project": "node scripts/api-only-runtime.mjs active-project",
    "test:task10:mysql": "node scripts/run-task10-mysql-gate.mjs",
    "test:task10:browser": "node scripts/run-task10-mysql-gate.mjs --browser",
    "check:context": "node scripts/context-check.mjs",
    "dev": "concurrently \"pnpm --filter ./backend dev:mysql\" \"pnpm --filter ./frontend dev\"",
    "dev:shensi": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:mysql": "concurrently \"pnpm --filter ./backend dev:mysql\" \"pnpm --filter ./frontend dev\"",
    "deploy:shensi": "node --env-file-if-exists=.env.production.local scripts/deploy.mjs",
    "dev:real": "node --env-file-if-exists=.env.real.local tools/start-real-local.mjs",
    "trial:prepare": "node scripts/real-trial-runtime.mjs prepare",
    "trial:showcase": "node scripts/real-trial-showcase.mjs",
    "trial:start": "node scripts/real-trial-runtime.mjs start",
    "trial:publish": "node scripts/real-trial-runtime.mjs publish",
    "trial:status": "node scripts/real-trial-runtime.mjs status",
    "trial:verify": "node scripts/real-trial-verify.mjs",
    "trial:stop": "node scripts/real-trial-runtime.mjs stop",
    "setup:mysql:local": "node --env-file-if-exists=.env.real.local backend/scripts/setup-local-mysql.ts",
    "build": "pnpm --filter ./contracts check:types && pnpm --filter ./backend build && pnpm --filter ./frontend build && pnpm website:build",
    "generate:frontend-contract-types": "pnpm --filter ./contracts generate:types",
    "check:generated-acquisition-types": "pnpm --filter ./contracts check:types",
    "build:growth-contract-release": "pnpm --filter ./contracts build:growth-release",
    "check:growth-contract-release": "pnpm --filter ./contracts check:growth-release",
    "check:growth-contracts": "pnpm check:growth-contract-release && pnpm --filter ./backend test:growth-openapi",
    "check:acquisition-contracts": "pnpm test:contracts && pnpm --filter ./backend test:contract-drift && pnpm --filter ./backend test:security && pnpm --filter ./backend test:acquisition-openapi && pnpm check:generated-acquisition-types && pnpm --filter ./frontend build && pnpm --filter ./frontend test && pnpm test:baota-package",
    "test:contracts": "pnpm --filter ./contracts test",
    "test:baota-package": "node --test deploy/baota/build-package.test.mjs",
    "test:trial-showcase": "node --test scripts/real-trial-showcase.test.mjs",
    "test:trial-runtime": "node --test scripts/real-trial-config.test.mjs scripts/real-trial-runtime.test.mjs scripts/real-trial-sidecar-container.test.mjs",
    "test:desktop": "pnpm --dir desktop test",
    "typecheck:desktop": "pnpm --dir desktop typecheck",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:local": "pnpm --dir desktop exec node --import tsx ../scripts/desktop-local-runtime.mjs start",
    "desktop:local:prepare": "node scripts/desktop-local-runtime.mjs prepare",
    "test:desktop-local": "node --test scripts/desktop-local-runtime.test.mjs && pnpm --dir backend exec node --import tsx --test src/runtime-env-test.ts",
    "desktop:test": "pnpm --dir desktop test",
    "desktop:typecheck": "pnpm --dir desktop typecheck",
    "desktop:build:renderer": "pnpm --filter ./frontend build:desktop && node desktop/scripts/verify-desktop-renderer.mjs frontend/dist-desktop",
    "desktop:build:main": "pnpm --dir desktop build:main",
    "desktop:build": "pnpm desktop:build:renderer && pnpm desktop:build:main && pnpm --dir desktop build:sidecar",
    "desktop:package:mac": "pnpm --dir desktop package:mac",
    "desktop:package:mac:release": "pnpm --dir desktop package:mac:release",
    "desktop:verify:mac": "pnpm --dir desktop verify:mac",
    "desktop:verify:mac:release": "pnpm --dir desktop verify:mac:release",
    "test": "pnpm test:contracts && pnpm --filter ./backend test && pnpm --filter ./frontend test && pnpm test:baota-package && pnpm test:trial-showcase && pnpm test:trial-runtime && pnpm test:desktop-local && pnpm website:test",
    "test:layout": "node --test tools/*.test.mjs",
    "test:mediacrawler-provenance": "node --test tools/mediacrawler-provenance.test.mjs",
    "test:financial-council": "pnpm --filter ./backend test:financial-council",
    "test:e2e": "pnpm --filter ./frontend test:e2e",
    "test:e2e:financial-council:real": "pnpm --filter ./frontend test:e2e:financial-council:real",
    "test:e2e:financial-council:real-runtime": "pnpm --filter ./frontend test:e2e:financial-council:real-runtime",
    "test:growth-release-gate": "node --test tools/growth-dual-repo-release-gate.test.mjs",
    "verify:shensi": "node scripts/verify.mjs",
    "release:growth": "node tools/growth-dual-repo-release-gate.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "yaml": "2.8.1"
  }
}
