FROM ghcr.io/astral-sh/uv:0.12.5 AS uv

FROM python:3.11.13-slim-bookworm AS builder
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /build
COPY services/media-crawler/pyproject.toml services/media-crawler/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

FROM python:3.11.13-slim-bookworm AS runtime
ENV PATH=/app/.venv/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=builder /build/.venv /app/.venv
RUN python -m playwright install --with-deps chromium \
    && groupadd --gid 10001 shensi \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin shensi \
    && chmod -R a-w /app /ms-playwright
COPY --chown=0:0 services/media-crawler/shensi_adapter /app/shensi_adapter
USER 10001:10001
EXPOSE 8899
STOPSIGNAL SIGTERM
CMD ["uvicorn", "shensi_adapter.app:app", "--host", "0.0.0.0", "--port", "8899", "--workers", "1", "--timeout-graceful-shutdown", "20"]
