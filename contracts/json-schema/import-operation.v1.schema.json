{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/import-operation.v1.schema.json",
  "title": "ImportOperation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ownerId",
    "teamId",
    "actorId",
    "fileName",
    "mediaType",
    "subjectChannel",
    "artifactHash",
    "status",
    "rowCount",
    "acceptedRowCount",
    "errorRows",
    "evidenceCount",
    "evidenceIds",
    "candidateCount",
    "candidateIds",
    "errorCode",
    "createdAt",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
    "mediaType": {
      "enum": [
        "text/csv",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ]
    },
    "subjectChannel": { "enum": ["organization", "individual"] },
    "artifactHash": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial_success",
        "failed"
      ]
    },
    "rowCount": { "type": "integer", "minimum": 0 },
    "acceptedRowCount": { "type": "integer", "minimum": 0 },
    "errorRows": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheetName", "rowNumber", "code", "message"],
        "properties": {
          "sheetName": { "type": "string", "minLength": 1 },
          "rowNumber": { "type": "integer", "minimum": 1 },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "evidenceCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 5000
    },
    "candidateCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "candidateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 5000
    },
    "errorCode": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "enum": ["queued", "running"] }
        }
      },
      "then": {
        "properties": {
          "rowCount": { "type": "integer", "const": 0 },
          "acceptedRowCount": { "type": "integer", "const": 0 },
          "errorRows": { "type": "array", "maxItems": 0 },
          "evidenceCount": { "type": "integer", "const": 0 },
          "evidenceIds": { "type": "array", "maxItems": 0 },
          "candidateCount": { "type": "integer", "const": 0 },
          "candidateIds": { "type": "array", "maxItems": 0 },
          "errorCode": { "type": "null" },
          "completedAt": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "required": ["evidenceCount"],
        "properties": {
          "evidenceCount": { "const": 0 }
        }
      },
      "then": {
        "properties": {
          "candidateCount": { "type": "integer", "const": 0 },
          "candidateIds": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "oneOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["evidenceCount"] },
              { "required": ["evidenceIds"] }
            ]
          }
        },
        {
          "required": ["evidenceCount", "evidenceIds"],
          "properties": {
            "evidenceCount": { "type": "integer", "const": 0 },
            "evidenceIds": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "required": ["evidenceCount", "evidenceIds"],
          "properties": {
            "evidenceCount": { "type": "integer", "minimum": 1 },
            "evidenceIds": { "type": "array", "minItems": 1 }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["candidateCount"] },
              { "required": ["candidateIds"] }
            ]
          }
        },
        {
          "required": ["candidateCount", "candidateIds"],
          "properties": {
            "candidateCount": { "type": "integer", "const": 0 },
            "candidateIds": { "type": "array", "maxItems": 0 }
          }
        },
        {
          "required": ["candidateCount", "candidateIds"],
          "properties": {
            "candidateCount": { "type": "integer", "minimum": 1 },
            "candidateIds": { "type": "array", "minItems": 1 }
          }
        }
      ]
    }
  ]
}
