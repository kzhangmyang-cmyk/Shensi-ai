    {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ownerId", "teamId", "leadId", "customerId", "eventType", "occurredAt", "amount", "reasonCode", "reasonText", "idempotencyKey", "createdBy", "createdAt", "recordKind", "legacySourceId", "partyRef", "candidateId", "attribution", "migrationWarnings"],
      "properties": {
        "id": {"type": "string"}, "ownerId": {"type": "string"}, "teamId": {"type": "string"}, "leadId": {"type": ["string", "null"]}, "customerId": {"type": ["string", "null"]}, "eventType": {"enum": ["validated", "contacted", "replied", "rejected", "do_not_contact", "private_domain_entered", "need_confirmed", "quoted", "won", "lost", "payment_received"]}, "occurredAt": {"type": "string", "format": "date-time"}, "amount": {"oneOf": [{"$ref": "#/$defs/amount"}, {"type": "null"}]}, "reasonCode": {"type": ["string", "null"]}, "reasonText": {"type": ["string", "null"]}, "idempotencyKey": {"type": "string"}, "createdBy": {"type": "string"}, "createdAt": {"type": "string", "format": "date-time"}, "recordKind": {"const": "legacy_migrated"}, "legacySourceId": {"type": "string", "minLength": 1}, "partyRef": {"oneOf": [{"$ref": "#/$defs/organizationPartyRef"}, {"type": "null"}]}, "candidateId": {"type": ["string", "null"]}, "attribution": {"$ref": "#/$defs/legacyAttribution"}, "migrationWarnings": {"type": "array", "items": {"type": "string"}}
      }
