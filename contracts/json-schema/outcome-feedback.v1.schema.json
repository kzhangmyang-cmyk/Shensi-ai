    "crawlerLiveAttribution": {"type":"object","additionalProperties":false,"required":["attributionVersion","runId","planId","planVersionId","planVersion","planSnapshotHash","discoveredEventId","discoveredAt","evidenceIds","providerIds","queryIds","strategyVersion","qualificationDecisionId","decisionVersion","decisionSnapshotHash","jobId","shardId","operationId","connectionId","providerId","decisionEngine","ruleVersion","modelProvider","model","promptVersion"],"properties":{"attributionVersion":{"const":"douyin-crawler.v1"},"runId":{"type":"string","minLength":1,"pattern":"\\S"},"planId":{"type":"string","minLength":1,"pattern":"\\S"},"planVersionId":{"type":"string","minLength":1,"pattern":"\\S"},"planVersion":{"type":"integer","minimum":1},"planSnapshotHash":{"type":"string","minLength":1,"pattern":"\\S"},"discoveredEventId":{"type":"string","minLength":1,"pattern":"\\S"},"discoveredAt":{"type":"string","format":"date-time"},"evidenceIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"providerIds":{"type":"array","maxItems":0,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"queryIds":{"type":"array","maxItems":0,"items":{"type":"string","minLength":1,"pattern":"\\S"}},"strategyVersion":{"type":"string","minLength":1,"pattern":"\\S"},"qualificationDecisionId":{"type":"string","minLength":1,"pattern":"\\S"},"decisionVersion":{"type":"string","minLength":1,"pattern":"\\S"},"decisionSnapshotHash":{"type":"string","minLength":1,"pattern":"\\S"},"jobId":{"type":"string","minLength":1,"pattern":"\\S"},"shardId":{"type":"null"},"operationId":{"type":"null"},"connectionId":{"type":"null"},"providerId":{"type":"null"},"decisionEngine":{"enum":["model","rules"]},"ruleVersion":{"type":"string"},"modelProvider":{"type":["string","null"]},"model":{"type":["string","null"]},"promptVersion":{"type":["string","null"]}}},
    "liveAttribution": {"oneOf":[{"$ref":"#/$defs/genericLiveAttribution"},{"$ref":"#/$defs/crawlerLiveAttribution"}]},
    "genericLiveAttribution": {
