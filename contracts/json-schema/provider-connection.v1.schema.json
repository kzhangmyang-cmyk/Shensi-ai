{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/provider-connection.v1.schema.json",
  "title": "ProviderConnection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ownerId",
    "teamId",
    "providerId",
    "kind",
    "status",
    "credentialVersion",
    "lastHealthAt",
    "lastHealthStatus",
    "lastErrorCode",
    "lastHealthMessage",
    "usage",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "teamId": { "type": ["string", "null"] },
    "providerId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["search", "content_fetch", "import"] },
    "status": { "enum": ["active", "inactive", "disabled", "error"] },
    "credentialVersion": { "type": "integer", "minimum": 1 },
    "lastHealthAt": { "type": ["string", "null"], "format": "date-time" },
    "lastHealthStatus": { "enum": ["untested", "passed", "failed"] },
    "lastErrorCode": { "type": ["string", "null"] },
    "lastHealthMessage": { "type": "string" },
    "usage": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
