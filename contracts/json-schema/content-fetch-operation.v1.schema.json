{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodjob.example/contracts/json-schema/content-fetch-operation.v1.schema.json",
  "title": "ContentFetchOperation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ownerId",
    "teamId",
    "actorId",
    "sourceUrl",
    "finalUrl",
    "subjectChannel",
    "status",
    "accessStatus",
    "httpStatus",
    "contentType",
    "title",
    "rawArtifactHash",
    "contentHash",
    "evidenceCount",
    "evidenceIds",
    "candidateCount",
    "candidateIds",
    "commentSampleSummary",
    "errorCode",
    "createdAt",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "teamId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "finalUrl": { "type": ["string", "null"], "format": "uri" },
    "subjectChannel": { "enum": ["organization", "individual"] },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial_success",
        "failed",
        "access_restricted"
      ]
    },
    "accessStatus": {
      "type": ["string", "null"],
      "enum": ["public_content", "access_restricted", null]
    },
    "httpStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
    "contentType": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "rawArtifactHash": { "type": ["string", "null"] },
    "contentHash": { "type": ["string", "null"] },
    "evidenceCount": { "type": "integer", "minimum": 0 },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "candidateCount": { "type": "integer", "minimum": 0, "maximum": 101 },
    "candidateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "maxItems": 101
    },
    "commentSampleSummary": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "videoCount",
            "pagesFetched",
            "commentsSampled",
            "eventCount",
            "evidenceCount",
            "candidateIds",
            "unresolvedActorCount",
            "strongSignalCount",
            "invalidCommentCount",
            "errors",
            "usage"
          ],
          "properties": {
            "status": {
              "enum": [
                "skipped",
                "succeeded",
                "succeeded_empty",
                "partial_success",
                "failed"
              ]
            },
            "videoCount": { "type": "integer", "minimum": 0, "maximum": 20 },
            "pagesFetched": { "type": "integer", "minimum": 0, "maximum": 100 },
            "commentsSampled": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "eventCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "evidenceCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "candidateIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true,
              "maxItems": 100
            },
            "unresolvedActorCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "strongSignalCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "invalidCommentCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "errors": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceUrl", "videoId", "code"],
                "properties": {
                  "sourceUrl": { "type": "string", "format": "uri", "maxLength": 4096 },
                  "videoId": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 100 },
                  "code": {
                    "enum": [
                      "public_sample_unavailable",
                      "access_restricted",
                      "rate_limited",
                      "video_id_unresolved",
                      "source_payload_invalid",
                      "no_public_comments"
                    ]
                  }
                }
              }
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requests", "results", "amountMinor", "durationSeconds"],
              "properties": {
                "requests": { "type": "integer", "minimum": 0 },
                "results": { "type": "integer", "minimum": 0 },
                "amountMinor": { "type": "integer", "minimum": 0 },
                "durationSeconds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "errorCode": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "enum": ["succeeded", "partial_success", "access_restricted"] },
        "evidenceCount": { "type": "integer", "const": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    {
      "properties": {
        "status": { "enum": ["queued", "running"] },
        "evidenceCount": { "type": "integer", "const": 0 },
        "evidenceIds": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "failed" },
        "evidenceCount": { "type": "integer", "const": 0 },
        "evidenceIds": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "status": { "const": "failed" },
        "evidenceCount": { "type": "integer", "const": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        }
      }
    }
  ],
