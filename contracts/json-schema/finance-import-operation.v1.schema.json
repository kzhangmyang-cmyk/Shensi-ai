{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://goodjob.example/contracts/json-schema/finance-import-operation.v1.schema.json", "title": "FinanceImportOperation",
  "type": "object", "additionalProperties": false,
  "required": ["id", "workspaceId", "kind", "status", "totalRows", "acceptedRows", "rejectedRows", "createdAt", "completedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 }, "workspaceId": { "type": "string", "minLength": 1, "not": { "const": "all" } }, "kind": { "enum": ["acquisition_cost", "financial_fact"] },
    "status": { "enum": ["previewed", "queued", "running", "succeeded", "failed", "requires_review"] }, "totalRows": { "type": "integer", "minimum": 0 }, "acceptedRows": { "type": "integer", "minimum": 0 }, "rejectedRows": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "FinanceImportPreviewInput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fileName", "mediaType", "contentBase64", "mapping"],
      "properties": {
        "kind": { "enum": ["acquisition_cost", "financial_fact"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mediaType": { "enum": ["text/csv", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"] },
        "contentBase64": { "type": "string", "minLength": 1 },
        "mapping": {
          "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "FinancialStatementUpload": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fileName", "mediaType", "contentBase64"],
      "properties": {
        "kind": { "enum": ["balance_sheet", "income_statement", "cash_flow_statement"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": { "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        "contentBase64": { "type": "string", "minLength": 1 }
      }
    },
    "FinancialStatementPackagePreviewInput": {
      "type": "object", "additionalProperties": false, "required": ["statements"],
      "properties": {
        "statements": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/FinancialStatementUpload" }, { "properties": { "kind": { "const": "balance_sheet" } } }] },
            { "allOf": [{ "$ref": "#/$defs/FinancialStatementUpload" }, { "properties": { "kind": { "const": "income_statement" } } }] },
            { "allOf": [{ "$ref": "#/$defs/FinancialStatementUpload" }, { "properties": { "kind": { "const": "cash_flow_statement" } } }] }
          ],
          "items": false
        }
      }
    },
    "FinancialStatementConsentInput": {
      "type": "object", "additionalProperties": false,
      "required": ["consent"],
      "properties": {
        "consent": { "type": "object", "additionalProperties": false,
          "required": ["accepted", "noticeVersion"],
          "properties": { "accepted": { "const": true },
            "noticeVersion": { "const": "financial-model-data.v1" } }
        },
        "cashForecast": { "$ref": "#/$defs/FinancialCashForecastSupplementInput" }
      }
    },
    "FinancialCashForecastReceivableInput": {
      "type": "object", "additionalProperties": false,
      "required": ["customer", "amountMinor", "daysOutstanding"],
      "properties": {
        "customer": { "type": "string", "minLength": 1, "maxLength": 255 },
        "amountMinor": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "daysOutstanding": { "type": "integer", "minimum": 0, "maximum": 3650 }
      }
    },
    "FinancialCashForecastSupplementInput": {
      "type": "object", "additionalProperties": false,
      "required": ["forecastAsOf", "expectedInflowsNext30DaysMinor", "expectedOutflowsNext30DaysMinor", "expectedInflowsNext31To90DaysMinor", "expectedOutflowsNext31To90DaysMinor", "receivables", "attestation"],
      "properties": {
        "forecastAsOf": { "type": "string", "format": "date-time" },
        "expectedInflowsNext30DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedOutflowsNext30DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedInflowsNext31To90DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedOutflowsNext31To90DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "receivables": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/FinancialCashForecastReceivableInput" } },
        "attestation": {
          "type": "object", "additionalProperties": false,
          "required": ["accepted", "noticeVersion"],
          "properties": {
            "accepted": { "const": true },
            "noticeVersion": { "const": "financial-cash-forecast.v1" }
          }
        }
      }
    },
    "FinancialCashForecastPublicView": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "forecastAsOf", "currency", "expectedInflowsNext30DaysMinor", "expectedOutflowsNext30DaysMinor", "expectedInflowsNext31To90DaysMinor", "expectedOutflowsNext31To90DaysMinor", "receivablesCount", "noticeVersion", "acceptedAt", "forecastHash"],
      "properties": {
        "source": { "const": "management_attested" },
        "forecastAsOf": { "type": "string", "format": "date-time" },
        "currency": { "enum": ["CNY", "USD"] },
        "expectedInflowsNext30DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedOutflowsNext30DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedInflowsNext31To90DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expectedOutflowsNext31To90DaysMinor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "receivablesCount": { "type": "integer", "minimum": 0, "maximum": 100 },
        "noticeVersion": { "const": "financial-cash-forecast.v1" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "forecastHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "FinancialStatementSourceView": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fileName", "fileHash", "mediaType", "sheetNames"],
      "properties": {
        "kind": { "enum": ["balance_sheet", "income_statement", "cash_flow_statement"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "mediaType": { "const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
        "sheetNames": { "type": "array", "minItems": 1, "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
      }
    },
    "FinancialStatementPackagePreviewView": {
      "type": "object", "additionalProperties": false,
      "required": ["previewId", "status", "expiresAt", "companyName", "currency", "period", "sourceFiles", "parserVersion", "warningCodes", "createdAt"],
      "properties": {
        "previewId": { "type": "string", "minLength": 1 }, "status": { "const": "preview" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "companyName": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["CNY", "USD"] }, "period": { "type": "string", "minLength": 1 },
        "sourceFiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/FinancialStatementSourceView" } },
        "parserVersion": { "const": "financial-statements.v2" },
        "warningCodes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FinancialStatementPackageView": {
      "type": "object", "additionalProperties": false,
      "required": ["packageId", "status", "expiresAt", "companyName", "currency", "period", "sourceFiles", "parserVersion", "warningCodes", "forecastStatus", "cashForecast", "createdAt"],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 }, "status": { "const": "verified" },
        "expiresAt": { "type": "null" }, "companyName": { "type": "string", "minLength": 1 },
        "currency": { "enum": ["CNY", "USD"] }, "period": { "type": "string", "minLength": 1 },
        "sourceFiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/FinancialStatementSourceView" } },
        "parserVersion": { "const": "financial-statements.v2" },
        "warningCodes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
        "forecastStatus": { "enum": ["computed", "not_computable"] },
        "cashForecast": { "oneOf": [{ "$ref": "#/$defs/FinancialCashForecastPublicView" }, { "type": "null" }] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FinanceImportRowErrorCode": { "enum": ["spreadsheet_formula_forbidden", "verified_import_forbidden", "required_field_missing", "money_invalid", "currency_invalid", "business_time_invalid", "commercial_binding_invalid", "row_identity_conflict", "financial_fact_conflict", "financial_fact_amount_invalid", "amount_out_of_range"] },
    "FinanceImportRowError": {
      "type": "object", "additionalProperties": false, "required": ["rowNumber", "code", "field", "message"],
      "properties": { "rowNumber": { "type": "integer", "minimum": 1 }, "code": { "$ref": "#/$defs/FinanceImportRowErrorCode" }, "field": { "type": ["string", "null"] }, "message": { "type": "string", "minLength": 1 } }
    },
    "FinanceImportPreview": {
      "type": "object", "additionalProperties": false, "required": ["previewId", "kind", "totalRows", "acceptedRows", "rejectedRows", "errors", "expiresAt"],
      "properties": { "previewId": { "type": "string", "minLength": 1 }, "kind": { "enum": ["acquisition_cost", "financial_fact"] }, "totalRows": { "type": "integer", "minimum": 0 }, "acceptedRows": { "type": "integer", "minimum": 0 }, "rejectedRows": { "type": "integer", "minimum": 0 }, "errors": { "type": "array", "items": { "$ref": "#/$defs/FinanceImportRowError" } }, "expiresAt": { "type": "string", "format": "date-time" } }
    }
  }
}
