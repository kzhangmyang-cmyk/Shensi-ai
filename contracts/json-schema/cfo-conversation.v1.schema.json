{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.goodjob.ai/cfo-conversation.v1.schema.json",
  "title": "CfoConversationAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "provider", "model", "material", "answeredAt"],
  "properties": {
    "research": { "$ref": "#/$defs/Research" },
    "knowledge": { "$ref": "knowledge.v1.schema.json#/$defs/Answer" },
    "libraryStatus": { "$ref": "system-reference.v1.schema.json#/$defs/LibraryStatus" },
    "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "material": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/MaterialSource" }, { "$ref": "finance-document.v1.schema.json#/$defs/MaterialSource" }] },
    "answeredAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "Research": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "query", "searchProvider", "retrievedAt", "evidenceKind", "citationIds", "sources"],
      "properties": {
        "status": { "const": "completed" },
        "query": { "type": "string", "minLength": 2, "maxLength": 500 },
        "searchProvider": { "type": "string", "minLength": 1, "maxLength": 191 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "evidenceKind": { "const": "search_index_snippets" },
        "citationIds": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "pattern": "^S[1-5]$" } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "title", "url", "snippet", "fetchedAt"],
          "properties": {
            "id": { "type": "string", "pattern": "^S[1-5]$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 300 },
            "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 4000 },
            "snippet": { "type": "string", "minLength": 1, "maxLength": 3000 },
            "fetchedAt": { "type": "string", "format": "date-time" }
          }
        } }
      }
    },
    "Input": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "history"],
      "dependentRequired": { "referenceTopicIds": ["referenceProtocol"] },
      "properties": {
        "referenceProtocol": { "const": "system-v1", "description": "Explicit negotiated text protocol. Omitted is private-only; knowledgeMode off or omitted closes both libraries." },
        "referenceTopicIds": { "$ref": "system-reference.v1.schema.json#/$defs/ReferenceTopicSelection" },
        "knowledgeMode": { "enum": ["auto", "off"], "default": "off", "description": "Bounded private reference retrieval for text; omitted preserves legacy and voice behavior." },
        "webSearchMode": { "enum": ["on", "off"], "description": "Explicit text search preference: off skips planning and public search; on requires safe public retrieval or an explicit error. Omitted preserves legacy automatic planning. Independent from knowledgeMode." },
        "conversationKey": { "type": "string", "format": "uuid", "description": "Required for a chat attachment: must match the conversation used when parsing it, together with the selected role." },
        "documentId": { "type": ["string", "null"], "minLength": 1, "maxLength": 255, "description": "Exact actor/workspace-scoped read-only document selected by this conversation. Missing/expired IDs never fall back to a verified package. Null or omitted retains verified-package semantics." },
        "role": { "enum": ["cfo", "finance", "profit", "cost", "cashflow", "tax"], "default": "cfo", "description": "Selected specialist; omitted means CFO. One role/model per question." },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "history": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/Turn" } }
      }
    },
    "Turn": {
      "type": "object", "additionalProperties": false, "required": ["role", "text"],
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "MaterialSource": {
      "type": "object", "additionalProperties": false,
      "required": ["packageId", "companyName", "period", "currency"],
      "properties": {
        "packageId": { "type": "string" }, "companyName": { "type": "string" },
        "period": { "type": "string" }, "currency": { "type": "string" }
      }
    }
  }
}
