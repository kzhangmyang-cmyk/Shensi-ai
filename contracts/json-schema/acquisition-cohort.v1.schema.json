{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://goodjob.example/contracts/json-schema/acquisition-cohort.v1.schema.json", "title": "AcquisitionCohort",
  "type": "object", "additionalProperties": false,
  "required": ["id", "workspaceId", "platform", "cohortFrom", "cohortTo", "definitionVersion", "firstTouchRuleVersion", "status", "createdAt"],
  "properties": {
    "id": { "$ref": "#/$defs/nonempty" }, "workspaceId": { "type": "string", "minLength": 1, "not": { "const": "all" } }, "platform": { "$ref": "#/$defs/nonempty" },
    "cohortFrom": { "$ref": "#/$defs/dateTime" }, "cohortTo": { "$ref": "#/$defs/dateTime" }, "definitionVersion": { "$ref": "#/$defs/nonempty" }, "firstTouchRuleVersion": { "$ref": "#/$defs/nonempty" },
    "status": { "enum": ["active", "superseded"] }, "createdAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }, "dateTime": { "type": "string", "format": "date-time" },
    "AcquisitionCohortCreateInput": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "cohortFrom", "cohortTo", "definitionVersion", "firstTouchRuleVersion"],
      "properties": {
        "platform": { "$ref": "#/$defs/nonempty" }, "cohortFrom": { "$ref": "#/$defs/dateTime" }, "cohortTo": { "$ref": "#/$defs/dateTime" },
        "definitionVersion": { "$ref": "#/$defs/nonempty" }, "firstTouchRuleVersion": { "$ref": "#/$defs/nonempty" }
      }
    },
    "ClosureEvidenceRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "sourceReportId", "reportHash"], "properties": { "kind": { "const": "source_report" }, "sourceReportId": { "$ref": "#/$defs/nonempty" }, "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "ledgerType", "ledgerEntryId", "evidenceHash"], "properties": { "kind": { "const": "ledger_entry" }, "ledgerType": { "enum": ["cost", "financial"] }, "ledgerEntryId": { "$ref": "#/$defs/nonempty" }, "evidenceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "ledgerType", "ledgerEntryId", "verificationEventId"], "properties": { "kind": { "const": "verification" }, "ledgerType": { "enum": ["cost", "financial"] }, "ledgerEntryId": { "$ref": "#/$defs/nonempty" }, "verificationEventId": { "$ref": "#/$defs/nonempty" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "allocationKind", "allocationSetId", "version"], "properties": { "kind": { "const": "allocation_set" }, "allocationKind": { "enum": ["attribution", "settlement"] }, "allocationSetId": { "$ref": "#/$defs/nonempty" }, "version": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "ClosureAttestationCreateInput": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "aspect", "periodFrom", "periodTo", "asOf", "declaredTotalMinor", "sourceSystem", "sourceCursor", "sourceReportId", "reportAllocationSetId", "reportHash", "evidenceRefs"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "aspect": { "enum": ["acquisition_cost", "revenue", "cogs", "cash", "refund_bad_debt", "attribution"] },
        "periodFrom": { "$ref": "#/$defs/dateTime" }, "periodTo": { "$ref": "#/$defs/dateTime" }, "asOf": { "$ref": "#/$defs/dateTime" },
        "declaredTotalMinor": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }, "sourceSystem": { "$ref": "#/$defs/nonempty" },
        "sourceCursor": { "type": ["string", "null"], "minLength": 1 }, "sourceReportId": { "type": ["string", "null"], "minLength": 1 },
        "reportAllocationSetId": { "type": ["string", "null"], "minLength": 1 }, "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClosureEvidenceRef" } }
      }
    },
    "AcquisitionCohortMember": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "cohortId", "workspaceId", "platform", "canonicalSubjectId", "subjectStableKey", "primaryCandidateId", "firstDiscoveredAt", "firstPlanId", "firstRunId", "firstShardId", "attributionSnapshot", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" }, "cohortId": { "$ref": "#/$defs/nonempty" }, "workspaceId": { "type": "string", "minLength": 1, "not": { "const": "all" } }, "platform": { "$ref": "#/$defs/nonempty" },
        "canonicalSubjectId": { "$ref": "#/$defs/nonempty" }, "subjectStableKey": { "$ref": "#/$defs/nonempty" }, "primaryCandidateId": { "$ref": "#/$defs/nonempty" }, "firstDiscoveredAt": { "$ref": "#/$defs/dateTime" },
        "firstPlanId": { "$ref": "#/$defs/nonempty" }, "firstRunId": { "$ref": "#/$defs/nonempty" }, "firstShardId": { "$ref": "#/$defs/nonempty" }, "attributionSnapshot": { "$ref": "outcome-feedback.v1.schema.json#/$defs/liveAttribution" }, "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "ClosureAttestation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspaceId", "cohortId", "currency", "aspect", "periodFrom", "periodTo", "asOf", "declaredTotalMinor", "sourceSystem", "sourceCursor", "sourceReportId", "reportAllocationSetId", "reportHash", "evidenceRefs", "status", "signedBy", "signedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" }, "workspaceId": { "type": "string", "minLength": 1, "not": { "const": "all" } }, "cohortId": { "$ref": "#/$defs/nonempty" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "aspect": { "enum": ["acquisition_cost", "revenue", "cogs", "cash", "refund_bad_debt", "attribution"] }, "periodFrom": { "$ref": "#/$defs/dateTime" }, "periodTo": { "$ref": "#/$defs/dateTime" }, "asOf": { "$ref": "#/$defs/dateTime" },
        "declaredTotalMinor": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }, "sourceSystem": { "$ref": "#/$defs/nonempty" }, "sourceCursor": { "type": ["string", "null"], "minLength": 1 },
        "sourceReportId": { "type": ["string", "null"], "minLength": 1 }, "reportAllocationSetId": { "type": ["string", "null"], "minLength": 1 }, "reportHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClosureEvidenceRef" } }, "status": { "enum": ["signed", "superseded"] }, "signedBy": { "$ref": "#/$defs/nonempty" }, "signedAt": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
